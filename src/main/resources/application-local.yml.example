spring:
  datasource:
    url: jdbc:mysql://localhost:3306/cnwasshu
    username: cnwasshu
    password: ${DB_PASSWORD}      # docker-compose.yml에 설정한 MySQL 비밀번호 입력
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true

kakao:
  client-id: ${KAKAO_CLIENT_ID}          # 카카오 개발자 콘솔 > 앱 키 > REST API 키
  client-secret: ${KAKAO_CLIENT_SECRET:} # 클라이언트 시크릿 활성화한 경우에만 필요
  redirect-uri: ${KAKAO_REDIRECT_URI:}   # 예: http://localhost:8080/api/auth/kakao

jwt:
  secret: ${JWT_SECRET}                  # 32자 이상 임의 문자열
  access-token-validity-seconds: ${JWT_ACCESS_TOKEN_VALIDITY:1800}
  refresh-token-validity-seconds: ${JWT_REFRESH_TOKEN_VALIDITY:1209600}